# =====================================================================
# Fetan Bet Environment Variables (.env.example)
# Copy this file to .env and provide your actual values.
# NEVER commit .env to source control!
# =====================================================================

NODE_ENV=development
PORT=3000
JWT_SECRET=your_super_secret_jwt_key_here

# ---------------------------------------------------------------------
# Neon PostgreSQL Connection Strings
#
# 1. DATABASE_URL:
#    The Neon POOLED connection string (host contains "-pooler", sslmode=require)
#    Used for normal application runtime connections.
#    e.g. postgresql://fetan_app:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# 2. DIRECT_DATABASE_URL:
#    The Neon DIRECT unpooled connection string (host does NOT contain "-pooler", sslmode=require)
#    Used exclusively for schema migrations by an admin/owner role (e.g. neondb_owner).
#    e.g. postgresql://neondb_owner:ownerpassword@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# 3. TEST_DATABASE_URL:
#    Points to a dedicated Neon child branch (e.g. 'test' branch) for automated tests.
#    e.g. postgresql://neondb_owner:ownerpassword@ep-xyz-test.us-east-2.aws.neon.tech/neondb?sslmode=require
# ---------------------------------------------------------------------
DATABASE_URL=
DIRECT_DATABASE_URL=
TEST_DATABASE_URL=

# Optional seed credentials
ADMIN_PASSWORD=
AGENT_PASSWORD=
