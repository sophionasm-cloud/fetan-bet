{
  "name": "fetan-bet",
  "version": "1.0.0",
  "description": "ፍጣን ቤት (Fetan Bet) - virtual-credit demo platform",
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings server.js",
    "test": "node --no-warnings scripts/run-integration-tests.js",
    "test:integration:check": "node --no-warnings scripts/run-integration-tests.js --check",
    "test:payout": "node --no-warnings payout.test.js && node --no-warnings payout-rules.test.js",
    "test:static": "node --no-warnings payout.test.js && node --no-warnings payout-rules.test.js && node --no-warnings scripts/test-db-safety.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^18.0.8",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1"
  }
}
